# Copy to .env and fill in. Postgres values must match docker-compose.yml.
# Values containing spaces or < > must be quoted: run_pipeline.sh sources this file as shell.

# ── PostgreSQL (required) ────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=fab
PG_USER=postgres
PG_PASSWORD=change-me
#PG_POOL_MAX=10

# ── Email: magic-link sign-in + trade/buylist notifications (optional) ───────
# Without RESEND_API_KEY auth runs in dev mode: the sign-in link is returned in
# the API response instead of being emailed.
RESEND_API_KEY=
RESEND_FROM="FAB Matrix <noreply@example.com>"
# Frontend base for emailed links (defaults to the public API URL)
#MAGIC_LINK_BASE=https://fabmatrix.example.com

# ── Hosting (optional; defaults suit the author's setup) ─────────────────────
#API_PORT=8001
#NAMED_TUNNEL=fab                               # Cloudflare named tunnel
#NAMED_TUNNEL_URL=https://fabmatrix.example.com # its public hostname
#ENDPOINT_GIST_ID=                              # gist the Android app reads the API URL from
#PUSH_LOVABLE=0                                 # 1 = push frontend .env when the URL changes

# ── Buylist (optional) ───────────────────────────────────────────────────────
# Username of the store account that buys cards; defaults to `t4ngo`.
#BUYLIST_STORE_USERNAME=
